{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>simplify9/.github//renovate/default"],
  "schedule": ["* 0-8 * * 3"],
  "lockFileMaintenance": { "schedule": ["* 0-8 * * 3"] },
  "packageRules": [
    { "description": "Android build toolchain (Gradle, Android Gradle Plugin, Kotlin) must match what the framework supports: it moves with the framework upgrade, behind dashboard approval, never automerged",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchDepNames": ["gradle", "com.android.application", "com.android.library", "com.android.tools.build:gradle", "/^org\\.jetbrains\\.kotlin/"],
      "groupName": "android toolchain", "groupSlug": "android-toolchain", "dependencyDashboardApproval": true, "automerge": false },
    { "description": "iOS toolchain (CocoaPods and the Ruby gems behind it): verify has no iOS build, so a person merges these after an iOS build",
      "matchManagers": ["cocoapods", "bundler"],
      "groupName": "ios toolchain", "groupSlug": "ios-toolchain", "automerge": false },
    { "description": "React Native core moves as one lockstep set; placed after default rules so it wins",
      "matchPackageNames": ["react", "react-dom", "react-native", "@react-native/**", "@react-native-community/cli**", "metro**", "react-test-renderer", "@types/react"],
      "groupName": "react-native core", "groupSlug": "rn-core" }
  ]
}
