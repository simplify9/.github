{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":maintainLockFilesMonthly"],
  "timezone": "Asia/Amman",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "lockFileMaintenance": { "enabled": true, "automerge": true },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    { "description": "Weekly routine group: non-breaking updates move together so lockstep sets cannot split; 0.x patches are non-breaking in practice and automerge",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "non-major dependencies", "groupSlug": "non-major", "automerge": true },
    { "description": "npm soak against compromised fresh releases",
      "matchDatasources": ["npm"], "minimumReleaseAge": "7 days" },
    { "description": "0.x minors can break: own branch, dashboard approval, never automerged (regex matcher works for every datasource, unlike isBreaking)",
      "matchCurrentVersion": "/^v?0\\./", "matchUpdateTypes": ["minor"],
      "groupName": null, "dependencyDashboardApproval": true, "automerge": false },
    { "description": "Major updates need a human: dashboard approval, never automerged",
      "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true, "automerge": false }
  ]
}
